{
  "name": "gym-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web": "npm run dev -w apps/web",
    "mobile": "npm run start -w apps/mobile",
    "build": "npm run build -w apps/web",
    "typecheck": "tsc -p apps/web --noEmit",
    "lint": "npm run lint -w apps/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:start": "supabase start"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vitest": "^2.1.1"
  },
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  }
}